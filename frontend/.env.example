# FastAPI origin. Leave blank to use the Vite proxy (/api → localhost:8000).
VITE_API_BASE_URL=http://localhost:8000

# Use in-memory typed mock adapters (no backend required).
VITE_USE_MOCKS=true

# Intercept /api with Mock Service Worker instead of the typed adapter.
# Requires VITE_USE_MOCKS=false so axios still issues requests.
VITE_USE_MSW=false
